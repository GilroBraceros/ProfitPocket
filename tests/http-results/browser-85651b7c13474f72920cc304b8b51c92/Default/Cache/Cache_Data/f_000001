.dashboard-filter .form-select, .dashboard-filter .form-control { font-size: .79rem; padding: .45rem .65rem; border-color: #dce4df; border-radius: 5px; min-height: 34px; }
.period-controls { min-width: 164px; }
.date-controls { display: flex; align-items: flex-end; gap: 10px; }
.date-controls[hidden] { display: none; }
.date-range-separator { color: #8b958e; margin-bottom: 8px; }
.dashboard-page .btn-primary { --bs-btn-bg: #1b6465; --bs-btn-border-color: #1b6465; --bs-btn-hover-bg: #124c4d; --bs-btn-hover-border-color: #124c4d; border-radius: 5px; }
.dashboard-page .btn-sm { font-size: .76rem; padding: .46rem .8rem; min-height: 34px; }
.filter-note { color: #8b958e; font-size: .7rem; margin: 0 0 8px auto; }
.summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.summary-card { background: #fff; border: 1px solid #e4e9e6; border-radius: 8px; padding: 18px 20px 16px; min-width: 0; }
.summary-label { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.summary-label h2 { font-size: .78rem; font-weight: 550; color: #657269; margin: 0; }
.summary-label .pp-icon { color: #83968b; width: 16px; height: 16px; }
.summary-amount { font-size: clamp(1.45rem, 2.2vw, 1.95rem); font-weight: 650; letter-spacing: -.04em; font-variant-numeric: tabular-nums; margin: 14px 0 6px; overflow-wrap: anywhere; }
.summary-description { font-size: .67rem; color: #7e8a82; line-height: 1.5; margin: 0; min-height: 2.7em; }
.summary-comparison { font-size: .65rem; color: #7b8880; line-height: 1.5; margin: 12px 0 0; padding-top: 10px; border-top: 1px solid #edf1ee; }
.amount-positive { color: #20845b; }
.amount-negative { color: #c94a4a; }
.overview-notes { margin: 10px 0 22px; color: #7b8880; font-size: .69rem; line-height: 1.6; }
.overview-notes p { margin: 3px 0; }
.overview-notes .cost-warning { color: #9d6a1f; }
.cost-warning .pp-icon { width: 13px; height: 13px; }
.panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 22px 16px; }
.panel-heading h2, .quick-actions h2 { font-size: .94rem; font-weight: 650; margin: 0 0 5px; }
.panel-heading p, .quick-actions p { font-size: .73rem; color: #7f8a83; margin: 0; }
.chart-legend { display: flex; gap: 18px; font-size: .71rem; color: #6b776f; }
.chart-legend > span { display: flex; gap: 7px; align-items: center; }
.legend-dot { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
.sales-dot { background: #269967; }
.expenses-dot { background: #9caaa3; }
.financial-chart-wrap { height: 270px; margin: 4px 22px 18px; position: relative; }
.chart-data-table { padding: 0 22px 16px; font-size: .7rem; color: #758079; }
.chart-data-table summary { width: fit-content; cursor: pointer; }
.chart-data-table .table { font-size: .75rem; margin-top: 12px; }
.chart-fallback { position: absolute; inset: 40% 20px auto; text-align: center; color: #7f8a83; }
.empty-state { padding: 38px 22px; text-align: center; color: #7c8b81; }
.empty-state h3, .empty-state h2 { font-size: .9rem; font-weight: 550; margin: 0 0 8px; color: #56665b; }
.empty-state p { font-size: .78rem; margin: 0; }
.chart-empty { min-height: 244px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.chart-empty > .pp-icon { width: 27px; height: 27px; margin-bottom: 15px; color: #9cab9f; }
.quick-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; padding: 16px 22px; }
.action-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
.action-buttons .btn { display: inline-flex; align-items: center; gap: 6px; border-color: #dce4df; color: #78847c; opacity: 1; background: #fafcfb; font-size: .7rem; }
.action-buttons .pp-icon { width: 13px; height: 13px; }
.action-soon { font-size: .58rem; border-left: 1px solid #dfe6e1; padding-left: 6px; color: #8f9a93; }
.table-period { color: #8b958f; font-size: .7rem; white-space: nowrap; }
.transactions-table { font-size: .77rem; vertical-align: middle; min-width: 790px; }
.transactions-table th { color: #7a867e; background: #fafcfb; font-size: .67rem; font-weight: 550; padding: 11px 14px; white-space: nowrap; border-top: 1px solid #e8ede9; border-bottom: 1px solid #e8ede9; }
.transactions-table td { padding: 14px; border-color: #eef2ef; color: #526058; }
.transactions-table td:first-child, .transactions-table th:first-child { padding-left: 22px; }
.transactions-table td:last-child, .transactions-table th:last-child { padding-right: 22px; }
.transaction-reference { font-weight: 550; max-width: 180px; overflow-wrap: anywhere; }
.transaction-type { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.transaction-type .pp-icon { width: 13px; height: 13px; color: #829289; }
.transaction-description { max-width: 250px; overflow-wrap: anywhere; }
.transaction-context { display: block; font-size: .65rem; color: #8f9992; margin-top: 3px; }
.transaction-amount { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
.transaction-date { white-space: nowrap; }
.transactions-table .amount-negative { color: #c94a4a; }
.payment-badge { display: inline-block; font-size: .65rem; padding: 4px 7px; border-radius: 4px; background: #edf3ef; color: #54715f; white-space: nowrap; }
.status-partial, .status-unpaid { background: #faf3e4; color: #97732c; }
.status-refunded { background: #f4eff0; color: #906b70; }
.table-footnote { font-size: .65rem; color: #8a958e; padding: 13px 22px; border-top: 1px solid #edf1ee; }
.dashboard-footer { font-size: .67rem !important; color: #9aa59d !important; padding: 0 30px 22px; }
.mobile-brand { width: 48px; height: 48px; object-fit: contain; }
@media (min-width: 992px) {
    .business-sidebar { position: fixed; inset: 0 auto 0 0; height: 100vh; height: 100dvh; z-index: 1040; overflow-y: auto; display: flex; }
    .business-topbar, .dashboard-main, .dashboard-footer { margin-left: var(--sidebar-width); }
    .dashboard-page.sidebar-collapsed { --sidebar-width: 76px; }
    .sidebar-collapsed .sidebar-logo-full, .sidebar-collapsed .sidebar-text, .sidebar-collapsed .sidebar-upcoming, .sidebar-collapsed .sidebar-section-label, .sidebar-collapsed .sidebar-note { display: none; }
    .sidebar-collapsed .sidebar-logo-icon { display: block; }
    .sidebar-collapsed .sidebar-brand { padding: 15px 4px 20px; }
    .sidebar-collapsed .business-navigation, .sidebar-collapsed .sidebar-bottom { padding-left: 10px; padding-right: 10px; }
    .sidebar-collapsed .sidebar-link { justify-content: center; padding: 12px 0; }
}
@media (min-width: 992px) and (max-width: 1199px) { .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 991px) {
    .business-topbar { padding: 8px 18px; }
    .dashboard-main { padding: 24px 18px; }
    .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .topbar-title, .topbar-separator { display: none; }
    .dashboard-footer { padding-left: 18px; }
    .dashboard-skip { left: 10px; }
}
@media (max-width: 575px) {
    .business-topbar { padding: 5px 12px; min-height: 60px; gap: 4px; }
    .profile-name, .profile-button > .pp-icon { display: none; }
    .topbar-business { font-size: .72rem; max-width: 190px; }
    .dashboard-main { padding: 20px 12px; }
    .dashboard-heading { display: block; margin-bottom: 18px; }
    .dashboard-heading h1 { font-size: 1.3rem; }
    .dashboard-heading p { font-size: .75rem; }
    .period-label { margin-top: 12px; font-size: .7rem; }
    .dashboard-filter { gap: 10px; padding: 14px; }
    .period-controls { flex: 1; min-width: 130px; }
    .date-controls { order: 3; width: 100%; min-width: 0; }
    .date-controls > div { flex: 1; min-width: 0; }
    .date-controls input { width: 100%; min-width: 0; }
    .filter-note { order: 4; margin: 0; width: 100%; }
    .summary-grid { gap: 10px; }
    .summary-card { padding: 14px 12px; }
    .summary-label h2 { font-size: .7rem; }
    .summary-label .pp-icon { display: none; }
    .summary-amount { font-size: clamp(1.1rem, 5vw, 1.5rem); }
    .summary-description { font-size: .61rem; min-height: 3em; }
    .summary-comparison { font-size: .6rem; }
    .panel-heading { padding: 16px 14px; align-items: flex-start; }
    .chart-legend { gap: 7px; flex-direction: column; font-size: .65rem; }
    .financial-chart-wrap { height: 220px; margin: 0 12px 16px; }
    .chart-data-table { padding-left: 14px; padding-right: 14px; }
    .quick-actions { padding: 16px 14px; }
    .action-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
    .action-buttons .btn { justify-content: center; padding: .45rem .3rem; font-size: .65rem; }
    .action-soon { font-size: .53rem; }
    .table-period { display: none; }
    .dashboard-footer { padding-left: 12px; padding-right: 12px; }
}

/* Sales Management uses the existing owner workspace and compact controls. */
