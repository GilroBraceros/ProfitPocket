:root { --forest: #18543d; --forest-dark: #103e2c; --bs-primary: #18543d; }

/* Owner announcements and in-app support. Admin styling lives in admin.css. */
.admin-fallback,.support-fallback { max-width:850px; margin:0 auto; }
.admin-field { margin-bottom:18px; }
.admin-check { display:flex; align-items:flex-start; gap:10px; margin:16px 0; }
.admin-check input { flex-shrink:0; }
.admin-text,.support-text { overflow-wrap:anywhere; line-height:1.7; }
.admin-message { padding:16px; border:1px solid #e3eae5; background:#fafcfb; border-radius:5px; margin:12px 0; overflow-wrap:anywhere; }
.admin-message span { display:block; font-size:.72rem; color:#566b5d; margin-top:4px; }
.admin-message p { margin:12px 0 0; }
.platform-modal .modal-content { border:1px solid #dce5df; border-radius:7px; }
.platform-modal .admin-form { display:flex; flex:1; flex-direction:column; min-height:0; overflow:hidden; max-height:100%; }
.platform-modal .modal-header,.platform-modal .modal-footer { flex-shrink:0; padding:18px 24px; }
.platform-modal .modal-body { min-height:0; overflow-y:auto; padding:24px; }
.platform-modal .modal-title,.admin-fallback .modal-title,.support-fallback .modal-title { font-size:1.05rem; font-weight:650; }
.platform-modal h3,.admin-fallback h3,.support-fallback h3 { font-size:.94rem; font-weight:600; margin-top:14px; }
.platform-modal .form-label { font-size:.8rem; }
.platform-modal .form-control,.platform-modal .form-select { font-size:.86rem; }
.platform-modal .modal-footer .btn { min-height:40px; font-size:.82rem; }
.owner-announcements { margin-top:20px; }
.announcement-list { padding:0 22px 6px; }
.announcement-item { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:16px 0; border-top:1px solid #edf1ee; }
.announcement-item > div { min-width:0; }
.announcement-item h3 { font-size:.88rem; margin:0 0 5px; font-weight:600; overflow-wrap:anywhere; }
.announcement-item time { color:#61766a; font-size:.7rem; }
.announcement-item p { font-size:.78rem; color:#516858; margin:8px 0 0; overflow-wrap:anywhere; }
.announcement-item .record-action-view { flex-shrink:0; }
.announcement-empty { padding:0 22px 20px; color:#63796b; font-size:.78rem; margin:0; }
.support-contact { display:flex; justify-content:space-between; gap:28px; align-items:flex-start; padding:20px 22px; }
.support-contact > div { min-width:0; }
.support-contact h2 { font-size:.95rem; margin:0 0 8px; }
.support-contact p { font-size:.78rem; line-height:1.6; margin:0; overflow-wrap:anywhere; color:#536d5b; }
.support-contact-details { display:flex; flex-direction:column; gap:7px; font-size:.76rem; overflow-wrap:anywhere; }
.support-note { font-size:.75rem; color:#5b7162; line-height:1.6; }
.support-tabs { display:flex; gap:20px; border-bottom:1px solid #e2eae5; padding:0 22px; }
.support-tabs a { text-decoration:none; color:#5b7262; font-size:.81rem; padding:16px 0; border-bottom:2px solid transparent; }
.support-tabs a.active { font-weight:600; color:#18543d; border-bottom-color:#18543d; }
.support-filter { border-bottom:1px solid #edf1ee; }
.support-filter > div { min-width:160px; }
.support-count { font-size:.72rem; color:#607766; padding-bottom:8px; }
.support-record { display:flex; justify-content:space-between; gap:24px; padding:20px 22px; border-bottom:1px solid #edf1ee; }
.support-record > div { min-width:0; }
.support-record h2 { font-size:.88rem; font-weight:600; margin:0 0 7px; overflow-wrap:anywhere; }
.support-record p { margin:5px 0 0; font-size:.73rem; color:#5a7161; }
.support-record-action { display:flex; flex-direction:column; gap:12px; align-items:flex-end; flex-shrink:0; }
.support-ticket-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
.support-history { font-size:.75rem; color:#57715e; margin:16px 0; }
@media(max-width:767px) {
    .support-contact { flex-direction:column; gap:16px; }
}
@media(max-width:575px) {
    .platform-modal .modal-content { border:0; border-radius:0; }
    .platform-modal .modal-header,.platform-modal .modal-footer { padding:16px; }
    .platform-modal .modal-body { padding:18px 16px; }
    .platform-modal .modal-footer .btn { flex:1; min-height:44px; }
    .announcement-list { padding:0 16px; }
    .announcement-item { flex-direction:column; align-items:flex-start; gap:12px; }
    .announcement-empty { padding:0 16px 18px; }
    .support-contact { padding:18px 16px; }
    .support-record { padding:18px 16px; flex-direction:column; gap:14px; }
    .support-record-action { flex-direction:row; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .support-ticket-heading { flex-wrap:wrap; }
}

/* Reports reuse the dashboard shell; these rules only style the report content. */
.report-heading-actions { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.report-print-heading { display:none; }
.report-print-view .report-print-heading { display:block; margin-bottom:20px; }
.report-print-heading h2 { font-size:1.1rem; font-weight:650; overflow-wrap:anywhere; }
.report-print-heading p { color:#59675e; font-size:.8rem; }
.report-profit-dot { background:#18543d; }
.report-tabs { gap:4px; margin-bottom:0; border-color:#dce5df; flex-wrap:wrap; }
.report-tabs .nav-link { font-size:.8rem; color:#52645a; padding:12px 16px; }
.report-tabs .nav-link.active { color:#18543d; font-weight:650; border-color:#dce5df #dce5df #fff; }
.report-panel { border-top-left-radius:0; }
.report-facts { display:flex; flex-wrap:wrap; gap:18px 30px; padding:0 22px 20px; border-bottom:1px solid #edf1ee; }
.report-facts > div { min-width:100px; max-width:100%; }
.report-facts span { display:block; color:#617268; font-size:.7rem; margin-bottom:5px; }
.report-facts strong { font-weight:600; font-size:1rem; overflow-wrap:anywhere; }
.report-table-filters { border-bottom:1px solid #edf1ee; }
.report-table-filters > div { min-width:0; }
.report-search { flex:1; max-width:330px; min-width:170px !important; }
.report-scope { padding:12px 22px; margin:0; font-size:.7rem; color:#627267; line-height:1.6; overflow-wrap:anywhere; }
.report-table { font-size:.77rem; vertical-align:middle; min-width:730px; font-variant-numeric:tabular-nums; }
.report-table th { font-size:.7rem; font-weight:600; color:#52645b; background:#fafcfb; padding:12px 16px; border-color:#e8eee9; }
.report-table tbody th { background:#fff; font-size:.77rem; max-width:230px; overflow-wrap:anywhere; }
.report-table td { padding:14px 16px; color:#45574b; border-color:#edf1ee; }
.report-table td.text-end { white-space:nowrap; }
.report-table tbody tr:hover > * { background:#f6faf7; }
.report-table .amount-negative { color:#a72e38; }
.report-pagination { display:flex; justify-content:flex-end; align-items:center; flex-wrap:wrap; gap:12px; padding:16px 22px; font-size:.75rem; }
.report-distribution { padding:14px 22px; border-bottom:1px solid #edf1ee; font-size:.77rem; }
.report-distribution summary { color:#18543d; cursor:pointer; }
.report-distribution table { margin-top:12px; }
.report-profit-layout { display:grid; grid-template-columns:1fr 1fr; gap:28px; padding:0 22px 22px; }
.report-profit-layout > * { min-width:0; }
.report-profit-lines { margin:0; }
.report-profit-lines > div { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:13px 0; border-bottom:1px solid #edf1ee; }
.report-profit-lines dt { font-size:.8rem; font-weight:500; }
.report-profit-lines dt span { display:block; font-size:.68rem; color:#637368; font-weight:400; line-height:1.5; margin-top:4px; }
.report-profit-lines dd { font-size:.95rem; font-weight:600; font-variant-numeric:tabular-nums; text-align:right; white-space:nowrap; margin:0; }
.report-profit-lines .report-profit-total { border-bottom-color:#ccdcd1; }
.report-profit-total dt { font-weight:650; }
.report-profit-total:last-child { background:#f0f7f2; padding:14px 10px; border-radius:5px; }
.report-cash-note { background:#f7f9f8; border:1px solid #e4eae6; border-radius:5px; padding:14px; margin-top:18px; font-size:.76rem; }
.report-cash-note p { color:#596b60; font-size:.7rem; margin:6px 0 0; line-height:1.6; }
.report-products h3 { font-size:.9rem; font-weight:650; }
.report-products p { color:#5e7064; font-size:.7rem; line-height:1.6; }
.report-products-table { min-width:430px; }
.report-products-table th,.report-products-table td { padding:12px 9px; }
.report-detail-modal .modal-content { border:1px solid #dce5df; border-radius:8px; }
.report-detail-modal .modal-title { font-size:1.1rem; }
.report-detail-modal .modal-subtitle { margin:4px 0 0; color:#65746a; font-size:.8rem; }
.report-detail-modal .modal-body { overflow-y:auto; }
@media(max-width:1199px) { .report-profit-layout { grid-template-columns:1fr; } }
@media(max-width:575px) {
    .report-heading-actions { margin-top:14px; }
    .report-heading-actions .period-label { margin:0; }
    .report-tabs .nav-link { flex:1 0 45%; text-align:center; padding:11px 8px; }
    .report-facts { padding:0 14px 16px; gap:18px; }
    .report-facts > div { flex:1 0 40%; }
    .report-search { min-width:0 !important; max-width:none; flex:1 0 100%; }
    .report-table-filters > div { flex:1 0 100%; }
    .report-scope,.report-distribution { padding-left:14px; padding-right:14px; }
    .report-profit-layout { padding:0 14px 18px; }
    .report-profit-lines > div { flex-wrap:wrap; gap:8px; }
    .report-profit-lines dt { flex:1 0 155px; }
    .report-profit-lines dd { margin-left:auto; }
    .report-detail-modal .modal-content { border:0; border-radius:0; }
}
@media print {
    body.reports-layout { background:#fff !important; color:#000; font-size:10pt; }
    .reports-layout .business-sidebar,.reports-layout .business-topbar,.reports-layout .dashboard-footer,.reports-layout .dashboard-skip,.reports-layout .report-no-print,.reports-layout .modal-backdrop,.reports-layout .report-detail-modal { display:none !important; }
    .reports-layout .dashboard-main { margin:0 !important; padding:0 !important; max-width:none; }
    .report-print-heading { display:block !important; }
    .reports-page .dashboard-heading { margin-bottom:12px; }
    .reports-page .summary-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
    .reports-page .summary-card { padding:10px; break-inside:avoid; }
    .reports-page .summary-amount { font-size:14pt; }
    .reports-page .dashboard-panel { box-shadow:none; border-color:#bfc9c2; break-inside:auto; }
    .reports-page .table-responsive { overflow:visible !important; }
    .reports-page .report-table { min-width:0; width:100%; table-layout:auto; font-size:8pt; }
    .reports-page .report-table th,.reports-page .report-table td { padding:7px 5px; white-space:normal; overflow-wrap:anywhere; }
    .reports-page .report-table thead { display:table-header-group; }
    .reports-page .report-table tr { break-inside:avoid; }
    .reports-page .report-profit-layout { grid-template-columns:1fr; }
    .reports-page .report-profit-lines > div { break-inside:avoid; }
    .reports-page .chart-panel { display:none; }
    .reports-page a { color:inherit; text-decoration:none; }
}
body { background: #f5f8f6; color: #21392c; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
a { color: var(--forest); }
a:hover { color: var(--forest-dark); }
.brand { color: var(--forest); font-size: 1.65rem; font-weight: 750; letter-spacing: -.05em; text-decoration: none; }
.app-navbar { background: var(--forest-dark); }
.eyebrow { color: var(--forest); font-size: .75rem; font-weight: 700; letter-spacing: .13em; }
.card { border: 1px solid #dee8e1; border-radius: 1rem; box-shadow: 0 8px 32px rgba(20, 70, 45, .04); }
.auth-shell { display: grid; grid-template-columns: 1.15fr 1fr; gap: 5rem; align-items: center; min-height: 83vh; padding-top: 3rem; padding-bottom: 3rem; max-width: 1080px; }
.auth-intro h1 { font-size: clamp(2.3rem, 4vw, 3.6rem); font-weight: 750; letter-spacing: -.05em; line-height: 1.12; }
.intro-copy { color: #567061; font-size: 1.1rem; line-height: 1.7; max-width: 26rem; margin-top: 1.5rem; }
.auth-card { padding: 2.2rem; }
.auth-card h2 { font-weight: 700; letter-spacing: -.025em; }
.registration-wrap { max-width: 740px; }
.help-card { max-width: 520px; }
.form-control, .form-select { padding: .7rem .85rem; border-color: #cbd9d0; }
.form-control:focus, .form-select:focus { border-color: #438969; box-shadow: 0 0 0 .2rem rgba(24, 84, 61, .13); }
.form-label { font-size: .9rem; font-weight: 600; }
.btn-primary { --bs-btn-bg: #18543d; --bs-btn-border-color: #18543d; --bs-btn-hover-bg: #103e2c; --bs-btn-hover-border-color: #103e2c; --bs-btn-active-bg: #103e2c; --bs-btn-active-border-color: #103e2c; --bs-btn-disabled-bg: #18543d; --bs-btn-disabled-border-color: #18543d; padding: .75rem 1rem; font-weight: 600; }
dd { overflow-wrap: anywhere; }
@media (max-width: 767px) {
    .auth-shell { grid-template-columns: 1fr; gap: 1.5rem; min-height: auto; max-width: 520px; padding-top: 2rem; }
    .auth-intro .eyebrow { margin-top: 1.5rem !important; }
    .auth-intro h1 { font-size: 2.35rem; }
    .intro-copy { margin-top: 1rem; }
    .auth-card { padding: 1.5rem; }
}

/* Business dashboard: intentionally scoped so login and admin pages stay intact. */
.dashboard-page { --sidebar-width: 244px; --dashboard-brand: #1b6465; background: #f7f9f8; color: #25313b; font-size: .875rem; }
.dashboard-page .pp-icon { fill: currentColor; flex-shrink: 0; vertical-align: -.15em; }
.dashboard-page .min-width-0 { min-width: 0; }
.dashboard-page button:focus-visible, .dashboard-page a:focus-visible, .dashboard-page summary:focus-visible { outline: 3px solid #1b6465; outline-offset: 3px; }
.dashboard-skip { position: fixed; top: 8px; left: 260px; background: white; padding: 12px; z-index: 1100; }
.business-sidebar { width: var(--sidebar-width) !important; background: #fff !important; border-right: 1px solid #e5e9e7 !important; display: flex; flex-direction: column; }
.sidebar-brand { padding: 4px 12px 0; background: #fff; }
.sidebar-brand a { display: flex; align-items: center; justify-content: center; }
.sidebar-logo-full { width: 220px; max-width: 100%; height: auto; object-fit: contain; }
.sidebar-logo-icon { display: none; width: 64px; height: auto; object-fit: contain; }
.business-navigation { padding: 8px 14px; flex: 1; }
.sidebar-section-label { font-size: .63rem; font-weight: 650; letter-spacing: .12em; color: #84918b; padding: 0 12px; margin: 0 0 12px; }
.sidebar-link { display: flex; align-items: center; gap: 12px; min-height: 42px; padding: 10px 12px; margin-bottom: 3px; border-radius: 6px; text-decoration: none; color: #51615c; font-size: .84rem; line-height: 1.2; white-space: nowrap; }
.sidebar-link .pp-icon { width: 17px; height: 17px; }
.sidebar-link.active { background: #e9f3ef; color: #18543d; font-weight: 650; }
.sidebar-link.active:hover { background: #deede5; }
.sidebar-link.upcoming { color: #687770; cursor: default; }
.sidebar-upcoming { font-size: .57rem; border: 1px solid #e5e9e7; border-radius: 3px; padding: 2px 4px; margin-left: auto; color: #73817b; }
.sidebar-divider { border-top: 1px solid #edf0ee; margin: 20px 10px 14px; }
.sidebar-bottom { padding: 18px 14px; border-top: 1px solid #edf0ee; margin-top: auto; }
.sidebar-note { font-size: .7rem; color: #839088; margin: 0 12px 12px; }
.sidebar-logout { background: transparent; border: 0; width: 100%; text-align: left; }
.sidebar-logout:hover { color: #1b6465; background: #f1f5f3; }
.business-topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #fff; border-bottom: 1px solid #e5e9e7; min-height: 68px; padding: 10px 30px; }
.icon-button { display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; padding: 0; background: transparent; border: 1px solid transparent; border-radius: 5px; color: #697770; flex-shrink: 0; }
.icon-button:hover { background: #f0f4f1; border-color: #e5e9e7; }
.topbar-title { font-size: .83rem; font-weight: 650; }
.topbar-separator { height: 18px; width: 1px; background: #dde4df; margin: 0 8px; flex-shrink: 0; }
.topbar-business { color: #75817b; font-size: .8rem; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.profile-button { background: transparent; border: 0; display: flex; align-items: center; gap: 9px; padding: 4px; color: #38453e; }
.profile-initial { width: 31px; height: 31px; display: grid; place-items: center; background: #edf3ef; color: #1b6465; border: 1px solid #dce8e0; border-radius: 50%; font-size: .78rem; font-weight: 650; }
.profile-name { font-size: .8rem; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-button > .pp-icon { width: 12px; height: 12px; color: #88938d; }
.account-menu { min-width: 255px; max-width: calc(100vw - 32px); border-color: #e5e9e7; border-radius: 6px; box-shadow: 0 4px 16px #172d1910; font-size: .85rem; }
.account-menu .text-secondary { overflow-wrap: anywhere; }
.account-menu .dropdown-item { font-size: .85rem; padding: 9px 16px; }
.dashboard-main { max-width: 1640px; padding: 30px; }
.dashboard-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 22px; }
.dashboard-heading h1 { font-size: 1.5rem; font-weight: 650; letter-spacing: -.03em; margin: 0 0 6px; }
.dashboard-heading p { color: #748077; font-size: .82rem; margin: 0; }
.period-label { display: flex; gap: 8px; align-items: center; font-size: .78rem; color: #5c6b62; white-space: nowrap; }
.period-label .pp-icon { width: 14px; height: 14px; }
.dashboard-panel { background: #fff; border: 1px solid #e4e9e6; border-radius: 8px; margin-bottom: 20px; }
.dashboard-filter { display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap; padding: 16px 20px; }
.dashboard-filter label { display: block; font-size: .71rem; font-weight: 600; color: #637269; margin-bottom: 5px; }
.dashboard-filter .form-select, .dashboard-filter .form-control { font-size: .79rem; padding: .45rem .65rem; border-color: #dce4df; border-radius: 5px; min-height: 34px; }
.period-controls { min-width: 164px; }
.date-controls { display: flex; align-items: flex-end; gap: 10px; }
.date-controls[hidden] { display: none; }
.date-range-separator { color: #8b958e; margin-bottom: 8px; }
.dashboard-page .btn-primary { --bs-btn-bg: #1b6465; --bs-btn-border-color: #1b6465; --bs-btn-hover-bg: #124c4d; --bs-btn-hover-border-color: #124c4d; border-radius: 5px; }
.dashboard-page .btn-sm { font-size: .76rem; padding: .46rem .8rem; min-height: 34px; }
.filter-note { color: #8b958e; font-size: .7rem; margin: 0 0 8px auto; }
.summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.summary-card { background: #fff; border: 1px solid #e4e9e6; border-radius: 8px; padding: 18px 20px 16px; min-width: 0; }
.summary-label { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.summary-label h2 { font-size: .78rem; font-weight: 550; color: #657269; margin: 0; }
.summary-label .pp-icon { color: #83968b; width: 16px; height: 16px; }
.summary-amount { font-size: clamp(1.45rem, 2.2vw, 1.95rem); font-weight: 650; letter-spacing: -.04em; font-variant-numeric: tabular-nums; margin: 14px 0 6px; overflow-wrap: anywhere; }
.summary-description { font-size: .67rem; color: #7e8a82; line-height: 1.5; margin: 0; min-height: 2.7em; }
.summary-comparison { font-size: .65rem; color: #7b8880; line-height: 1.5; margin: 12px 0 0; padding-top: 10px; border-top: 1px solid #edf1ee; }
.amount-positive { color: #20845b; }
.amount-negative { color: #c94a4a; }
.overview-notes { margin: 10px 0 22px; color: #7b8880; font-size: .69rem; line-height: 1.6; }
.overview-notes p { margin: 3px 0; }
.overview-notes .cost-warning { color: #9d6a1f; }
.cost-warning .pp-icon { width: 13px; height: 13px; }
.panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 22px 16px; }
.panel-heading h2, .quick-actions h2 { font-size: .94rem; font-weight: 650; margin: 0 0 5px; }
.panel-heading p, .quick-actions p { font-size: .73rem; color: #7f8a83; margin: 0; }
.chart-legend { display: flex; gap: 18px; font-size: .71rem; color: #6b776f; }
.chart-legend > span { display: flex; gap: 7px; align-items: center; }
.legend-dot { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
.sales-dot { background: #269967; }
.expenses-dot { background: #9caaa3; }
.financial-chart-wrap { height: 270px; margin: 4px 22px 18px; position: relative; }
.chart-data-table { padding: 0 22px 16px; font-size: .7rem; color: #758079; }
.chart-data-table summary { width: fit-content; cursor: pointer; }
.chart-data-table .table { font-size: .75rem; margin-top: 12px; }
.chart-fallback { position: absolute; inset: 40% 20px auto; text-align: center; color: #7f8a83; }
.empty-state { padding: 38px 22px; text-align: center; color: #7c8b81; }
.empty-state h3, .empty-state h2 { font-size: .9rem; font-weight: 550; margin: 0 0 8px; color: #56665b; }
.empty-state p { font-size: .78rem; margin: 0; }
.chart-empty { min-height: 244px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.chart-empty > .pp-icon { width: 27px; height: 27px; margin-bottom: 15px; color: #9cab9f; }
.quick-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; padding: 16px 22px; }
.action-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
